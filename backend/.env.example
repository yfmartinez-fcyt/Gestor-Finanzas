# Configuración del Servidor
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Base de Datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestor_finanzas
DB_USER=postgres
DB_PASSWORD=tu_password

# Seguridad (JWT)
# Puedes generar una clave segura con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=cambia_este_secreto_access
JWT_REFRESH_SECRET=cambia_este_secreto_refresh
JWT_ACCESS_EXPIRES=5m
JWT_REFRESH_EXPIRES=1h

# Frontend URL (CORS)
# Para múltiples URLs, sepáralas por comas sin espacios (ej: http://localhost:5173,http://172.26.4.3:5173)
FRONTEND_URL=http://localhost:5173